# {DOMAIN} est remplacé par install.sh (ex. wildlink.arkerion.dev).
# Caddy obtient et renouvelle tout seul le certificat HTTPS.
{DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# API Go
	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy 127.0.0.1:8081
	}

	# Fichiers du site, avec un cache long pour les fichiers versionnés par Vite
	handle /assets/* {
		root * /opt/wildweb/web/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Toutes les autres adresses (/joueur/…, /compte…) renvoient l'appli React
	handle {
		root * /opt/wildweb/web/dist
		try_files {path} /index.html
		file_server
	}
}
